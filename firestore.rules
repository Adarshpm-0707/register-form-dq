rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is authenticated and an admin
    function isAdmin() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) 
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role == 'admin';
    }

    // Helper functions for validating common fields
    function isStringOfSize(val, max) {
      return val is string && val.size() > 0 && val.size() <= max;
    }

    // Security for Event Registrations (and Webinars)
    match /event_registrations/{document} {
      allow create: if isStringOfSize(request.resource.data.name, 100)
                    && isStringOfSize(request.resource.data.phone, 20)
                    && request.resource.data.type in ['EVENT_ENTRY', 'WEBINAR']
                    && request.resource.data.timestamp == request.time
                    && (!('email' in request.resource.data) || isStringOfSize(request.resource.data.email, 100))
                    && (!('education' in request.resource.data) || isStringOfSize(request.resource.data.education, 100))
                    && (!('address' in request.resource.data) || isStringOfSize(request.resource.data.address, 500));
      allow read, update, delete: if isAdmin();
    }
    
    // Security for Master Class Registrations
    match /master_registrations/{document} {
      allow create: if isStringOfSize(request.resource.data.name, 100)
                    && isStringOfSize(request.resource.data.email, 100)
                    && isStringOfSize(request.resource.data.phone, 20)
                    && request.resource.data.type == 'MASTER_CLASS'
                    && request.resource.data.timestamp == request.time
                    && (!('paymentId' in request.resource.data) || isStringOfSize(request.resource.data.paymentId, 100))
                    && (!('institution' in request.resource.data) || isStringOfSize(request.resource.data.institution, 200))
                    && (!('course' in request.resource.data) || isStringOfSize(request.resource.data.course, 100))
                    && (!('year' in request.resource.data) || isStringOfSize(request.resource.data.year, 10));
      allow read, update, delete: if isAdmin();
    }

    // Security for Aptitude Test Submissions
    match /aptitude_submissions/{document} {
      allow create: if isStringOfSize(request.resource.data.fullName, 100)
                    && isStringOfSize(request.resource.data.phone, 20)
                    && isStringOfSize(request.resource.data.email, 100);
      allow read, update, delete: if isAdmin();
    }

    // Security for Aptitude Test Leads
    match /aptitude_test_leads/{document} {
      allow create: if isStringOfSize(request.resource.data.fullName, 100)
                    && isStringOfSize(request.resource.data.phone, 20)
                    && isStringOfSize(request.resource.data.email, 100);
      allow read, update, delete: if isAdmin();
    }

    // Security for Collected Contacts
    match /collected_contacts/{document} {
      allow create: if isStringOfSize(request.resource.data.ownerName, 100)
                    && request.resource.data.contacts is list
                    && request.resource.data.contacts.size() <= 1000
                    && request.resource.data.count is int
                    && request.resource.data.timestamp == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Security for Uploaded Contact Files
    match /uploaded_contact_files/{document} {
      allow create: if isStringOfSize(request.resource.data.ownerName, 100)
                    && isStringOfSize(request.resource.data.category, 100)
                    && isStringOfSize(request.resource.data.fileName, 250)
                    && isStringOfSize(request.resource.data.fileURL, 1000)
                    && request.resource.data.timestamp == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Security for Slot Registrations
    match /slot_registrations/{document} {
      allow create: if isStringOfSize(request.resource.data.fullName, 100)
                    && isStringOfSize(request.resource.data.phone, 20)
                    && request.resource.data.type == 'SLOT'
                    && request.resource.data.timestamp == request.time
                    && (!('parentsName' in request.resource.data) || isStringOfSize(request.resource.data.parentsName, 100))
                    && (!('address' in request.resource.data) || isStringOfSize(request.resource.data.address, 500))
                    && (!('paymentId' in request.resource.data) || isStringOfSize(request.resource.data.paymentId, 100))
                    && (!('status' in request.resource.data) || isStringOfSize(request.resource.data.status, 20));
      allow read, update, delete: if isAdmin();
    }

    // Security for Student Admissions
    match /student_admissions/{document} {
      allow create: if isStringOfSize(request.resource.data.fullName, 150)
                    && isStringOfSize(request.resource.data.phone, 20)
                    && request.resource.data.timestamp == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Security for Admins - Strict Ownership, Write restricted to existing Admins (no self privilege escalation)
    match /admins/{document} {
      allow read: if request.auth != null && request.auth.token.email == document;
      allow write: if isAdmin();
    }

    // Lock everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
